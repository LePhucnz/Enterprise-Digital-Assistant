# ============================================================
# Enterprise Digital Assistant — Environment Variables
# ============================================================

# --- Ollama Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# --- LLM Parameters ---
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_STREAMING=true
LLM_TIMEOUT=120
LLM_CONTEXT_WINDOW=32768

# --- FastAPI Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
DEBUG=true

# --- Conversation Memory ---
MEMORY_TYPE=buffer
MEMORY_MAX_HISTORY=20
MEMORY_SUMMARY_MAX_TOKENS=500

# --- RAG & Vector Database ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=4
RAG_SEARCH_TYPE=similarity
RAG_SCORE_THRESHOLD=0.5
COLLECTION_NAME=enterprise_kb

# --- File Storage & Paths ---
DATA_DIR=data
VECTOR_DB_DIR=vector_db

# --- General App Settings ---
APP_NAME=Enterprise Digital Assistant
APP_VERSION=3.0.0
LOG_LEVEL=INFO
PROMPT_LOCALE=vi
